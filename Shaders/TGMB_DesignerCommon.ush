#pragma once

float TGMB_Luma(float4 Color)
{
	return dot(Color.rgb, float3(0.299, 0.587, 0.114));
}

float TGMB_Hash12(float2 P)
{
	float3 P3 = frac(float3(P.xyx) * 0.1031);
	P3 += dot(P3, P3.yzx + 33.33);
	return frac((P3.x + P3.y) * P3.z);
}

float2 TGMB_Hash22(float2 P)
{
	float3 P3 = frac(float3(P.xyx) * float3(0.1031, 0.1030, 0.0973));
	P3 += dot(P3, P3.yzx + 33.33);
	return frac((P3.xx + P3.yz) * P3.zy);
}

float3 TGMB_DecodeNormal(float4 Color, float InvertGreen)
{
	float3 Normal = Color.xyz * 2.0 - 1.0;
	Normal.y = lerp(Normal.y, -Normal.y, InvertGreen);
	return normalize(Normal);
}

float4 TGMB_EncodeNormal(float3 Normal)
{
	return float4(normalize(Normal) * 0.5 + 0.5, 1.0);
}

float3 TGMB_BlendNormalsRNM(float3 Base, float3 Detail)
{
	Base += float3(0.0, 0.0, 1.0);
	Detail *= float3(-1.0, -1.0, 1.0);
	return normalize(Base * dot(Base, Detail) / max(Base.z, 0.001) - Detail);
}

float3 TGMB_BlendNormalsWhiteout(float3 Base, float3 Detail)
{
	return normalize(float3(Base.xy + Detail.xy, Base.z * Detail.z));
}

float2 TGMB_Rotate(float2 P, float Angle)
{
	float S = sin(Angle);
	float C = cos(Angle);
	return float2(C * P.x - S * P.y, S * P.x + C * P.y);
}

float TGMB_SampleLuma(Texture2D Tex, float2 UV)
{
	return TGMB_Luma(Tex.Sample(SamplerStates_Linear_Wrap, UV));
}

float TGMB_ValueNoise(float2 P)
{
	float2 i = floor(P);
	float2 f = frac(P);
	float2 u = f * f * (3.0 - 2.0 * f);
	return lerp(
		lerp(TGMB_Hash12(i + float2(0.0, 0.0)), TGMB_Hash12(i + float2(1.0, 0.0)), u.x),
		lerp(TGMB_Hash12(i + float2(0.0, 1.0)), TGMB_Hash12(i + float2(1.0, 1.0)), u.x),
		u.y
	);
}

float TGMB_Fbm(float2 P, int Octaves)
{
	float Value = 0.0;
	float Amplitude = 0.5;
	for (int i = 0; i < 8; ++i)
	{
		if (i >= Octaves) break;
		Value += Amplitude * TGMB_ValueNoise(P);
		P *= 2.0;
		Amplitude *= 0.5;
	}
	return Value;
}

void TGMB_Sobel(Texture2D Tex, float2 UV, float2 Texel, out float EdgeX, out float EdgeY)
{
	float TL = TGMB_SampleLuma(Tex, UV + float2(-Texel.x, -Texel.y));
	float TC = TGMB_SampleLuma(Tex, UV + float2(0, -Texel.y));
	float TR = TGMB_SampleLuma(Tex, UV + float2(Texel.x, -Texel.y));
	float L  = TGMB_SampleLuma(Tex, UV + float2(-Texel.x, 0));
	float R  = TGMB_SampleLuma(Tex, UV + float2(Texel.x, 0));
	float BL = TGMB_SampleLuma(Tex, UV + float2(-Texel.x, Texel.y));
	float BC = TGMB_SampleLuma(Tex, UV + float2(0, Texel.y));
	float BR = TGMB_SampleLuma(Tex, UV + float2(Texel.x, Texel.y));

	EdgeX = (TR + 2.0 * R + BR) - (TL + 2.0 * L + BL);
	EdgeY = (BL + 2.0 * BC + BR) - (TL + 2.0 * TC + TR);
}
